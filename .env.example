# Salin file ini jadi .env.local buat development lokal, isi dengan nilai asli.
# JANGAN commit .env.local ke git — sudah di-ignore lewat .gitignore.

# Token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID channel Telegram tujuan (biasanya diawali -100)
TELEGRAM_CHAT_ID=

# String rahasia bebas, buat verifikasi request cron job Vercel.
# Generate sendiri, contoh: openssl rand -hex 32
# Set nilai yang sama di Vercel dashboard -> Settings -> Environment Variables
CRON_SECRET=

# URL project Supabase (Settings -> API di dashboard Supabase)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable/anon key Supabase, aman dipakai di client-side
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret service role key Supabase, HANYA untuk server-side (API routes/cron).
# JANGAN pernah expose ke client atau commit ke git.
SUPABASE_SERVICE_ROLE_KEY=
